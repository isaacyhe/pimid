# Doxyfile for PIMID
PROJECT_NAME           = "PIMID"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Processing-In-Memory Integrated Development Simulator"
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doc
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src @CMAKE_CURRENT_SOURCE_DIR@/include
RECURSIVE              = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES
